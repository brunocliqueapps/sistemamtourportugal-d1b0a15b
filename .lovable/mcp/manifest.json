{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://owbrfxntriauzkhoesap.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "crm-mtour-portugal",
      "version": "0.1.0",
      "title": "CRM Mtour Portugal"
    },
    "tools": [
      {
        "name": "search_clients",
        "title": "Pesquisar clientes",
        "description": "Search CRM clients by name, client number, email or phone; returns up to 20 matches.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 100,
              "description": "Text to search. Omit to list the most recent clients."
            },
            "status": {
              "type": "string",
              "maxLength": 50,
              "description": "Optional pipeline status filter, e.g. novo, fechado."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_service_orders",
        "title": "Listar ordens de serviço",
        "description": "List service orders (OS) in a date range, optionally for one client; returns up to 50.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Start service date (YYYY-MM-DD). Defaults to today."
            },
            "to": {
              "$ref": "#/properties/from",
              "description": "End service date (YYYY-MM-DD). Defaults to 30 days after start."
            },
            "client_id": {
              "type": "string",
              "format": "uuid",
              "description": "Optional client id from search_clients."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
